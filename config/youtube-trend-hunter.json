{
  "version": 1,
  "mode": "ai-tech",
  "language": "fr",
  "regions": ["FR", "US"],
  "window_days": 7,
  "recommendations": 10,
  "minimum_score": 25,
  "max_video_seconds": 300,
  "max_difficulty": 2,
  "allowed_categories": [],
