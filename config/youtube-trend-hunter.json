  "weights": {"outperformance": 25, "growth": 20, "confirmation": 15, "competition": 15, "production": 15, "french_relevance": 10},
  "repeat_after_hours": 48,
  "repeat_score_increase": 10,
  "elevenlabs": {"enabled": false, "model_id": "eleven_multilingual_v2", "voice_id": null, "max_characters": 4500}
