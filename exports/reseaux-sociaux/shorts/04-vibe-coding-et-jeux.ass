Dialogue: 0,0:00:00.00,0:00:44.00,Brand,,0,0,0,,SANDBOX
Dialogue: 0,0:00:00.00,0:00:44.00,Title,,0,0,0,,Vibe coder un jeu ne le rend pas amusant
Dialogue: 0,0:00:00.00,0:00:44.00,Footer,,0,0,0,,La discussion complète sur SANDBOX
Dialogue: 1,0:00:00.00,0:00:02.00,Caption,,0,0,0,,Bah, maintenant que la technique
Dialogue: 1,0:00:02.00,0:00:03.33,Caption,,0,0,0,,et le temps ne comptent plus,
Dialogue: 1,0:00:03.33,0:00:04.00,Caption,,0,0,0,,on se dit
Dialogue: 1,0:00:04.00,0:00:05.50,Caption,,0,0,0,,qu'on va pouvoir faire le jeu
Dialogue: 1,0:00:05.50,0:00:06.00,Caption,,0,0,0,,vidéo de
Dialogue: 1,0:00:06.00,0:00:08.57,Caption,,0,0,0,,nos rêves, plein de jeux vidéo,
Dialogue: 1,0:00:08.57,0:00:09.00,Caption,,0,0,0,,et
Dialogue: 1,0:00:09.00,0:00:10.00,Caption,,0,0,0,,on prend un coup d'humilité
Dialogue: 1,0:00:10.00,0:00:12.00,Caption,,0,0,0,,parce qu'on se rend compte que
Dialogue: 1,0:00:12.00,0:00:13.00,Caption,,0,0,0,,maintenant qu'on a la technique
Dialogue: 1,0:00:13.00,0:00:16.00,Caption,,0,0,0,,à portée de main, il faut
Dialogue: 1,0:00:16.00,0:00:17.00,Caption,,0,0,0,,des idées.
Dialogue: 1,0:00:17.00,0:00:20.00,Caption,,0,0,0,,Il faut faire un bon jeu.
Dialogue: 1,0:00:20.00,0:00:21.50,Caption,,0,0,0,,Un jeu n'est pas forcément fun.
Dialogue: 1,0:00:21.50,0:00:22.00,Caption,,0,0,0,,Tu peux
Dialogue: 1,0:00:22.00,0:00:23.00,Caption,,0,0,0,,avoir une idée
Dialogue: 1,0:00:23.00,0:00:26.00,Caption,,0,0,0,,très bonne et mal l'exécuter.
Dialogue: 1,0:00:26.00,0:00:27.71,Caption,,0,0,0,,Il faut du level design, plein
Dialogue: 1,0:00:27.71,0:00:28.00,Caption,,0,0,0,,de
Dialogue: 1,0:00:28.00,0:00:29.71,Caption,,0,0,0,,trucs auxquels on ne pense pas.
Dialogue: 1,0:00:29.71,0:00:30.00,Caption,,0,0,0,,On
Dialogue: 1,0:00:30.00,0:00:31.33,Caption,,0,0,0,,se rend vite compte qu'il n'y
Dialogue: 1,0:00:31.33,0:00:32.00,Caption,,0,0,0,,a pas que
Dialogue: 1,0:00:32.00,0:00:33.50,Caption,,0,0,0,,la technique qui compte dans un
Dialogue: 1,0:00:33.50,0:00:34.00,Caption,,0,0,0,,jeu vidéo,
Dialogue: 1,0:00:34.00,0:00:36.57,Caption,,0,0,0,,et on prend un coup d'humilité.
Dialogue: 1,0:00:36.57,0:00:37.00,Caption,,0,0,0,,Et
Dialogue: 1,0:00:37.00,0:00:38.50,Caption,,0,0,0,,voilà, j'ai trouvé ça. Je me
Dialogue: 1,0:00:38.50,0:00:39.00,Caption,,0,0,0,,suis rendu
Dialogue: 1,0:00:39.00,0:00:39.86,Caption,,0,0,0,,compte que tu avais une super
Dialogue: 1,0:00:39.86,0:00:40.00,Caption,,0,0,0,,idée
Dialogue: 1,0:00:40.00,0:00:42.00,Caption,,0,0,0,,et qu'en fait, quand tu y
Dialogue: 1,0:00:42.00,0:00:43.00,Caption,,0,0,0,,joues, c'est chiant.
Dialogue: 1,0:00:43.00,0:00:44.00,Caption,,0,0,0,,[rires] Exactement.
