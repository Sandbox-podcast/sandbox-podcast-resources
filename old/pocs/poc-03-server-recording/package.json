{
  "name": "@podcast/poc-03-server-recording",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "env:init": "node src/cli/init-env.ts",
    "media:make": "node src/cli/make-media.ts",
    "stack:up": "docker compose --env-file .local/.env up -d",
    "stack:down": "docker compose --env-file .local/.env down",
    "s1": "node src/cli/s1-nominal.ts",
    "s3:kill": "node src/cli/s3-egress-crash.ts kill",
    "s3:stop": "node src/cli/s3-egress-crash.ts stop",
    "s3b": "node src/cli/s3b-persistent-tmp.ts",
    "s3c": "node src/cli/s3c-storage-down.ts",
    "s3d": "node src/cli/s3d-local-output.ts",
    "s3e": "node src/cli/s3e-supervised-crash.ts",
    "s4": "node src/cli/s4-livekit-restart.ts",
    "s5": "node src/cli/s5-participant-drop.ts",
    "recover-mp4": "node src/cli/recover-mp4.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@podcast/recording-control": "workspace:*",
    "livekit-server-sdk": "^2.19.1",
    "zod": "^4.6.5"
  },
  "exports": {
    "./*": "./src/lib/*"
  }
}
